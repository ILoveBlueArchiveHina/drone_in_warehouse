<?xml version="1.0" ?>

<sdf version="1.8">
  <model name="crazyflie">
    
    <link name="base_footprint">
      <pose> 0 0 17.425E-3 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>16.571710E-06</ixx>
          <iyy>16.655602E-06</iyy>
          <izz>29.261652E-06</izz>
          <ixy>0.830806E-06</ixy>
          <ixz>0.718277E-06</ixz>
          <iyz>1.800197E-06</iyz>
        </inertia>
      </inertial>
      <collision name="base_footprint_collision">
        <geometry>
          <box>
            <size>0.10 0.10 34.850E-3</size>
          </box>
        </geometry>
      </collision>
      <visual name="base_footprint_visual">
        <geometry>
          <mesh>
            <uri>model://crazyflie/meshes/cf2_assembly.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>1 0 0 1</diffuse>   <!-- 想要的主要顏色（R G B A）-->
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <sensor name='multiranger' type='gpu_lidar'>
        <pose relative_to='base_footprint'>0 0 0.05 0 0 0</pose> 
        <topic>lidar</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>6.28</max_angle>
            </horizontal>
            <vertical>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-0.2618</min_angle>
                <max_angle>1.0472</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.01</min>
            <max>10</max>
            <resolution>1</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
      <sensor name="imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/imu</topic>
      </sensor>
    </link>
    
    <!-- <link name="head">
      <pose>0 0 0.2 0 0 0</pose>
      <visual name="head_visual">
        <geometry>
          <box>
            <size>0.2 0.2 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0 0 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link> -->

    <link name="m1_prop">
      <pose>0.031 -0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="m1_visual">
        <geometry>
          <mesh>
            <uri>model://crazyflie/meshes/ccw_prop.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.8 0 1</diffuse>   <!-- 想要的主要顏色（R G B A）-->
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>
    <link name="m2_prop">
      <pose>-0.031 -0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="m2_visual">
        <geometry>
          <mesh>
            <uri>model://crazyflie/meshes/cw_prop.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.8 0 1</diffuse>   <!-- 想要的主要顏色（R G B A）-->
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>
    <link name="m3_prop">
      <pose>-0.031 0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="m3_visual">
        <geometry>
          <mesh>
            <uri>model://crazyflie/meshes/ccw_prop.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.8 0 1</diffuse>   <!-- 想要的主要顏色（R G B A）-->
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>
    <link name="m4_prop">
      <pose>0.031 0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="m4_visual">
        <geometry>
          <mesh>
            <uri>model://crazyflie/meshes/cw_prop.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.8 0 1</diffuse>   <!-- 想要的主要顏色（R G B A）-->
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
    </link>
    <!-- <joint name="head_joint" type="fixed">
      <child>head</child>
      <parent>base_footprint</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint> -->
    <joint name="m1_joint" type="revolute">
      <child>m1_prop</child>
      <parent>base_footprint</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <joint name="m2_joint" type="revolute">
      <child>m2_prop</child>
      <parent>base_footprint</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <joint name="m3_joint" type="revolute">
      <child>m3_prop</child>
      <parent>base_footprint</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <joint name="m4_joint" type="revolute">
      <child>m4_prop</child>
      <parent>base_footprint</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>m1_joint</jointName>
      <linkName>m1_prop</linkName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>1.28192e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <actuator_number>0</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>m2_joint</jointName>
      <linkName>m2_prop</linkName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>1.28192e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <actuator_number>1</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>m3_joint</jointName>
      <linkName>m3_prop</linkName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>1.28192e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <actuator_number>2</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>m4_joint</jointName>
      <linkName>m4_prop</linkName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>1.28192e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <actuator_number>3</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-control-system"
      name="gz::sim::systems::MulticopterVelocityControl">
      <robotNamespace>crazyflie</robotNamespace>
      <commandSubTopic>cmd_vel</commandSubTopic>
      <enableSubTopic>enable</enableSubTopic>
      <comLinkName>base_footprint</comLinkName>
      <velocityGain>1.25 1.25 0.2425</velocityGain>
      <attitudeGain>0.02 0.02 0.02</attitudeGain>
      <angularRateGain>0.005 0.005 0.005</angularRateGain>
      <rotorConfiguration>
        <rotor>
          <jointName>m1_joint</jointName>
          <forceConstant>1.28192e-08</forceConstant>
          <momentConstant>0.005964552</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>m2_joint</jointName>
          <forceConstant>1.28192e-08</forceConstant>
          <momentConstant>0.005964552</momentConstant>
          <direction>-1</direction>
        </rotor>
        <rotor>
          <jointName>m3_joint</jointName>
          <forceConstant>1.28192e-08</forceConstant>
          <momentConstant>0.005964552</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>m4_joint</jointName>
          <forceConstant>1.28192e-08</forceConstant>
          <momentConstant>0.005964552</momentConstant>
          <direction>-1</direction>
        </rotor>
      </rotorConfiguration>
    </plugin>
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>