      <!--    3D 光達    -->
      <sensor name='mid360' type='gpu_lidar'>
        <pose relative_to='body'>0 0 0.1 0 0 0</pose> 
        <topic>lidar</topic>
        <ignition_frame_id>body</ignition_frame_id>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>6.28</max_angle>
            </horizontal>
            <vertical>
                <samples>60</samples>
                <resolution>1</resolution>
                <min_angle>-0.122173</min_angle>
                <max_angle>0.90757</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.5</min>
            <max>30</max>
            <resolution>1</resolution>
          </range>
        </ray>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
