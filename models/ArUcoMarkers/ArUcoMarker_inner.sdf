<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="ArUcoMarker_inner">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <visual name="marker_visual">
        <pose>0 0 0.001 0 0 0</pose> <!-- 微抬高避免 Z-fighting -->
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.09 0.09</size> <!-- 根據需求改大小 -->
          </plane>
        </geometry>
        <material>
          <pbr>
            <metal>
              <albedo_map>model://ArUcoMarkers/textures/inner_marker.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>